{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackgate.local/schemas/0.1/plan.schema.json",
  "title": "CheckPlan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/SafeId"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "$ref": "common.schema.json#/$defs/SafeId"
    },
    "input_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "policy_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "target_contract_hashes": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Sha256"
      },
      "minProperties": 1
    },
    "toolchain_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "environment_requirements_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "required_check_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "check-step.schema.json"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "plan_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "task_revision",
    "profile",
    "input_hash",
    "policy_hash",
    "target_contract_hashes",
    "toolchain_hash",
    "environment_requirements_hash",
    "required_check_ids",
    "steps",
    "plan_hash"
  ],
  "additionalProperties": false
}
