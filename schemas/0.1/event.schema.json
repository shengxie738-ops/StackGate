        "schema_version": {
          "const": "0.1"
        },
        "event_id": {
          "type": "string",
          "pattern": "^event_[A-Za-z0-9_-]+$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9_-]+$"
        },
        "seq": {
          "type": "integer",
