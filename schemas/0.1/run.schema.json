{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackgate.local/schemas/0.1/run.schema.json",
  "title": "RunManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]+$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]+$"
    },
    "phase": {
      "$ref": "common.schema.json#/$defs/Phase"
    },
    "verdict": {
      "$ref": "common.schema.json#/$defs/Verdict"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/UtcTimestamp"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/SafeId"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "repo_id": {
      "$ref": "common.schema.json#/$defs/SafeId"
    },
    "worktree_id": {
      "$ref": "common.schema.json#/$defs/SafeId"
    },
    "base_oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "git_object_format": {
      "type": "string",
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "input_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "plan_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "policy_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "target_contract_hashes": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Sha256"
      },
      "minProperties": 1
    },
    "tool_versions": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "minProperties": 1
    },
    "environment_ref": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/RelativePath"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "check-result.schema.json"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "canceled": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "phase",
    "verdict",
    "created_at",
    "started_at",
    "finished_at",
    "task_id",
    "task_revision",
    "repo_id",
    "worktree_id",
    "base_oid",
    "git_object_format",
    "input_hash",
    "plan_hash",
    "policy_hash",
    "target_contract_hashes",
    "tool_versions",
    "environment_ref",
    "data_revision",
    "checks",
    "artifact_refs",
    "coverage_gaps",
    "canceled"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "git_object_format": {
            "const": "sha1"
          }
        },
        "required": [
          "git_object_format"
        ]
      },
      "then": {
        "properties": {
          "base_oid": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "git_object_format": {
            "const": "sha256"
          }
        },
        "required": [
          "git_object_format"
        ]
      },
      "then": {
        "properties": {
          "base_oid": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
