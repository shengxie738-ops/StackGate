        "seq",
        "at",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "event_id": {
          "type": "string",
          "pattern": "^event_[A-Za-z0-9_-]+$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9_-]+$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "type": {
          "const": "run.finalized"
        },
        "payload": {
          "type": "object",
          "properties": {
            "payload_version": {
              "const": "0.1"
            },
            "phase": {
              "type": "string",
              "enum": [
                "COMPLETED",
                "CANCELED",
                "ABORTED"
              ]
            },
            "verdict": {
              "$ref": "common.schema.json#/$defs/Verdict"
            }
          },
          "required": [
            "payload_version",
            "phase",
            "verdict"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "run_id",
        "seq",
        "at",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
