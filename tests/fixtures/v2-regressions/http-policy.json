{
  "schema_version": "0.1",
  "purpose": "Shared allow/deny table for request authorization. The TypeScript authorizeRequest and the Python probe helper must produce the same decision and the same reason code for every case here; only one defect is introduced per case so a mismatch names the rule that changed.",
  "sentinels": {
    "__nan__": "Not-a-Number",
    "__infinity__": "positive infinity",
    "__negative_infinity__": "negative infinity",
    "__string__:<value>": "the literal string, used to prove numeric fields are not coerced"
  },
  "declaration": "api:GET /api/performance",
  "origin": "http://127.0.0.1:8000",
  "path": "/api/performance",
  "cases": [
    { "name": "declared_path_matches", "expected_allowed": true, "expected_reason": null },
    { "name": "different_path", "path": "/different-operation", "expected_allowed": false, "expected_reason": "OPERATION_PATH_MISMATCH" },
    { "name": "no_declaration", "declared_operation_key": null, "expected_allowed": false, "expected_reason": "DECLARATION_MISSING" },
    { "name": "fragment", "path": "/api/performance#ignored", "expected_allowed": false, "expected_reason": "PATH_FRAGMENT_FORBIDDEN" },
    { "name": "query", "path": "/api/performance?x=1", "expected_allowed": false, "expected_reason": "PATH_QUERY_FORBIDDEN" },
    { "name": "declared_method_differs", "declared_operation_key": "api:POST /api/performance", "expected_allowed": false, "expected_reason": "OPERATION_METHOD_MISMATCH" },
    { "name": "method_not_in_policy", "method": "POST", "declared_operation_key": "api:POST /api/performance", "expected_allowed": false, "expected_reason": "METHOD_NOT_AUTHORIZED" },
    { "name": "key_without_service", "declared_operation_key": "GET /api/performance", "expected_allowed": false, "expected_reason": "OPERATION_KEY_INVALID" },
    { "name": "key_service_illegal", "declared_operation_key": "bad service!:GET /api/performance", "expected_allowed": false, "expected_reason": "OPERATION_KEY_INVALID" },
    { "name": "key_method_lowercase", "declared_operation_key": "api:get /api/performance", "expected_allowed": false, "expected_reason": "OPERATION_KEY_INVALID" },
    { "name": "key_path_relative", "declared_operation_key": "api:GET api/performance", "expected_allowed": false, "expected_reason": "OPERATION_KEY_INVALID" },
    { "name": "key_no_path", "declared_operation_key": "api:GET", "expected_allowed": false, "expected_reason": "OPERATION_KEY_INVALID" },
    { "name": "origin_not_authorized", "allowed_origins": ["http://127.0.0.1:9000"], "expected_allowed": false, "expected_reason": "ORIGIN_NOT_AUTHORIZED" },
    { "name": "origin_with_path", "origin": "http://127.0.0.1:8000/api", "expected_allowed": false, "expected_reason": "ORIGIN_PATH_NOT_ALLOWED" },
    { "name": "origin_userinfo", "origin": "http://user:pass@127.0.0.1:8000", "expected_allowed": false, "expected_reason": "ORIGIN_USERINFO_FORBIDDEN" },
    { "name": "origin_unparseable", "origin": "127.0.0.1:8000", "expected_allowed": false, "expected_reason": "ORIGIN_UNPARSEABLE" },
    { "name": "origin_trailing_space", "origin": "http://127.0.0.1:8000 ", "expected_allowed": false, "expected_reason": "ORIGIN_CONTROL_CHARS" },
    { "name": "origin_scheme_forbidden", "origin": "ftp://127.0.0.1:8000", "expected_allowed": false, "expected_reason": "ORIGIN_SCHEME_FORBIDDEN" },
    { "name": "origin_trailing_slash_is_same_origin", "origin": "http://127.0.0.1:8000/", "expected_allowed": true, "expected_reason": null },
    { "name": "origin_mixed_case_host_normalizes", "origin": "http://Localhost:8000", "allowed_origins": ["http://localhost:8000"], "expected_allowed": true, "expected_reason": null },
    { "name": "origin_default_port_normalizes", "origin": "http://localhost:80", "allowed_origins": ["http://localhost"], "expected_allowed": true, "expected_reason": null },
    { "name": "path_relative", "path": "api/performance", "expected_allowed": false, "expected_reason": "PATH_INVALID" },
    { "name": "path_empty", "path": "", "expected_allowed": false, "expected_reason": "PATH_INVALID" },
    { "name": "path_double_separator", "path": "/api//performance", "expected_allowed": false, "expected_reason": "PATH_DUPLICATE_SEPARATOR_FORBIDDEN" },
    { "name": "path_dot_segment", "path": "/api/x/../performance", "expected_allowed": false, "expected_reason": "PATH_AMBIGUOUS_SEGMENT_FORBIDDEN" },
    { "name": "path_parent_segment", "path": "/api/../etc/passwd", "expected_allowed": false, "expected_reason": "PATH_AMBIGUOUS_SEGMENT_FORBIDDEN" },
    { "name": "path_backslash", "path": "/api\\performance", "expected_allowed": false, "expected_reason": "PATH_BACKSLASH_FORBIDDEN" },
    { "name": "path_percent_encoded", "path": "/api%2Fperformance", "expected_allowed": false, "expected_reason": "PATH_ENCODING_UNSUPPORTED" },
    { "name": "path_template", "path": "/api/{id}", "expected_allowed": false, "expected_reason": "PATH_TEMPLATE_UNSUPPORTED" },
    { "name": "path_control_char", "path": "/api/performance\t", "expected_allowed": false, "expected_reason": "PATH_CONTROL_CHARS_FORBIDDEN" },
    { "name": "declared_path_percent_encoded", "declared_operation_key": "api:GET /api%2Fperformance", "path": "/api%2Fperformance", "expected_allowed": false, "expected_reason": "PATH_ENCODING_UNSUPPORTED" },
    { "name": "deadline_nan", "policy": { "deadline_ms": "__nan__" }, "expected_allowed": false, "expected_reason": "DEADLINE_OUT_OF_RANGE" },
    { "name": "deadline_infinity", "policy": { "deadline_ms": "__infinity__" }, "expected_allowed": false, "expected_reason": "DEADLINE_OUT_OF_RANGE" },
    { "name": "deadline_negative_infinity", "policy": { "deadline_ms": "__negative_infinity__" }, "expected_allowed": false, "expected_reason": "DEADLINE_OUT_OF_RANGE" },
    { "name": "deadline_fraction", "policy": { "deadline_ms": 12.5 }, "expected_allowed": false, "expected_reason": "DEADLINE_OUT_OF_RANGE" },
    { "name": "deadline_string", "policy": { "deadline_ms": "__string__:5000" }, "expected_allowed": false, "expected_reason": "DEADLINE_OUT_OF_RANGE" },
    { "name": "deadline_zero", "policy": { "deadline_ms": 0 }, "expected_allowed": false, "expected_reason": "DEADLINE_OUT_OF_RANGE" },
    { "name": "deadline_above_ceiling", "policy": { "deadline_ms": 60001 }, "expected_allowed": false, "expected_reason": "DEADLINE_OUT_OF_RANGE" },
    { "name": "budget_nan", "policy": { "max_response_bytes": "__nan__" }, "expected_allowed": false, "expected_reason": "RESPONSE_BUDGET_OUT_OF_RANGE" },
    { "name": "budget_infinity", "policy": { "max_response_bytes": "__infinity__" }, "expected_allowed": false, "expected_reason": "RESPONSE_BUDGET_OUT_OF_RANGE" },
    { "name": "budget_fraction", "policy": { "max_response_bytes": 1024.5 }, "expected_allowed": false, "expected_reason": "RESPONSE_BUDGET_OUT_OF_RANGE" },
    { "name": "budget_bool", "policy": { "max_response_bytes": true }, "expected_allowed": false, "expected_reason": "RESPONSE_BUDGET_OUT_OF_RANGE" },
    { "name": "budget_above_ceiling", "policy": { "max_response_bytes": 2097152 }, "expected_allowed": false, "expected_reason": "RESPONSE_BUDGET_OUT_OF_RANGE" },
    { "name": "service_binding_matches", "allowed_origins": ["http://127.0.0.1:8000", "http://127.0.0.1:8001"], "service_origins": { "api": "http://127.0.0.1:8000", "mirror": "http://127.0.0.1:8001" }, "expected_allowed": true, "expected_reason": null },
    { "name": "service_binding_other_listed_origin", "origin": "http://127.0.0.1:8001", "allowed_origins": ["http://127.0.0.1:8000", "http://127.0.0.1:8001"], "service_origins": { "api": "http://127.0.0.1:8000", "mirror": "http://127.0.0.1:8001" }, "expected_allowed": false, "expected_reason": "SERVICE_ORIGIN_MISMATCH" },
    { "name": "service_binding_missing_for_service", "allowed_origins": ["http://127.0.0.1:8000"], "service_origins": { "mirror": "http://127.0.0.1:8001" }, "expected_allowed": false, "expected_reason": "SERVICE_ORIGIN_MISSING" },
    { "name": "service_binding_trailing_slash_matches", "allowed_origins": ["http://127.0.0.1:8000"], "service_origins": { "api": "http://127.0.0.1:8000/" }, "expected_allowed": true, "expected_reason": null },
    { "name": "service_binding_unparseable", "allowed_origins": ["http://127.0.0.1:8000"], "service_origins": { "api": "http://user@127.0.0.1:8000" }, "expected_allowed": false, "expected_reason": "SERVICE_ORIGIN_UNPARSEABLE" }
  ]
}
