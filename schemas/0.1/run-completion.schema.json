{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackgate.local/schemas/0.1/run-completion.schema.json",
  "title": "RunCompletion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]+$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]+$"
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/UtcTimestamp"
    },
    "pre_context_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "post_context_hash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "post_input_hash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "post_freshness": {
      "$ref": "common.schema.json#/$defs/Freshness"
    },
    "post_task_confirmed": {
      "type": "boolean"
    },
    "post_trust_valid": {
      "type": "boolean"
    },
    "canceled": {
      "type": "boolean"
    },
    "fatal_error": {
      "type": "boolean"
    },
    "diagnostics": {
      "$ref": "command-execution.schema.json#/properties/result/properties/diagnostics"
    },
    "scheduler_timings": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "queued_at": {
            "$ref": "common.schema.json#/$defs/UtcTimestamp"
          },
          "started_at": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/UtcTimestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/UtcTimestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "waiting_ms": {
            "type": "number",
            "minimum": 0
          },
          "execution_ms": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "queued_at",
          "started_at",
          "finished_at",
          "waiting_ms",
          "execution_ms"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "recorded_at",
    "pre_context_hash",
    "post_context_hash",
    "post_input_hash",
    "post_freshness",
    "post_task_confirmed",
    "post_trust_valid",
    "canceled",
    "fatal_error",
    "diagnostics",
    "scheduler_timings"
  ]
}
