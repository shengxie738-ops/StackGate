{
  "schema_version": "0.1",
  "purpose": "Shared JSON Pointer / own-property / finite-number table for V2-R04. The TypeScript evaluator (packages/core/src/services/probe-assertions.ts) and the Python evaluator (presets/fastapi-react/scripts/probe_helpers.py) are driven over exactly these rows and must agree on passed/reason, not only on the verdict. Only one defect is introduced per row so a mismatch names the rule that changed.",
  "pointer_contract": {
    "grammar": "A pointer must be a non-empty string starting with '/'. Segments are separated by '/' and may be empty, so '/' addresses the key \"\" and '//x' addresses the key \"\" then the key 'x' (RFC 6901). Inside a segment '~0' decodes to '~' and '~1' decodes to '/'; a '~' that is not followed by '0' or '1' is a malformed escape and is diagnosed, never evaluated.",
    "whole_document_pointer": "The RFC 6901 empty pointer is NOT accepted: schemas/0.1/probe-declaration.schema.json requires '^/' for every assertion pointer, so the evaluator refuses '' with POINTER_INVALID instead of silently addressing the root.",
    "array_index": "When the current node is an array the segment must be a canonical decimal index: '0' or [1-9][0-9]*. '01', '-', '-1', '+1', '1.0', '' and a name such as 'length' are malformed (POINTER_INDEX_INVALID), while a canonical index outside the array is simply absent (POINTER_NOT_FOUND). When the current node is an object the segment is a key, so the key '01' or '-' is read normally.",
    "own_properties_only": "Object lookup uses Object.hasOwn in TypeScript and `key in dict` in Python. Nothing inherited from a prototype can satisfy an assertion, and a real own member named 'constructor', '__proto__' or 'toString' is read like any other key. There is no keyword blacklist.",
    "missing_versus_malformed": "POINTER_NOT_FOUND means the path is absent; POINTER_INVALID, POINTER_ESCAPE_INVALID and POINTER_INDEX_INVALID mean the pointer itself is not usable and the assertion was never evaluated against the document."
  },
  "number_contract": {
    "assertions": "A number satisfies 'type: number' and the four comparison operators only when it is finite. Infinity and -Infinity - which is what JSON.parse('1e400') and json.loads('1e400') both produce - are refused. A boolean is never a number and a string is never converted to a number.",
    "parse_gate": "parseJsonResponse / parse_json_response refuse any number that is not finite, and any integral number whose magnitude exceeds 2^53-1, because the two languages cannot agree on such a value (JavaScript rounds it, Python keeps it exact). Bare NaN/Infinity/-Infinity literals are refused as what they are: not JSON.",
    "present_values": "null and false are present values: 'exists' keeps them, and 'equals' compares within one JSON type only."
  },
  "operator_contract": {
    "type": "The 'expected' of operator 'type' must be one of the four kind NAMES as strings: 'string', 'number', 'boolean', 'null'. A missing expected, a JSON null, a number or any other string is TYPE_EXPECTED_UNKNOWN - a diagnosis, never a silent pass and never conflated with the 'null' kind.",
    "equals": "Compares within one JSON type only. Scalars (string, number, boolean, null) can be compared; an array or object expected value is not declarable by the schema and is refused as VALUE_MISMATCH rather than compared structurally. 0 never equals false and 1 never equals true.",
    "comparisons": "number_lt/lte/gt/gte require both operands to be finite non-boolean numbers, otherwise NUMBER_OPERAND_REQUIRED. A string such as \"9\" is never converted.",
    "unknown_operator": "Any other operator is OPERATOR_UNSUPPORTED and is never evaluated."
  },
  "reason_codes": {
    "POINTER_INVALID": "the pointer is not a pointer this grammar accepts",
    "POINTER_ESCAPE_INVALID": "a '~' escape that is not '~0' or '~1'; diagnosed without evaluating",
    "POINTER_INDEX_INVALID": "a non-canonical array index against an array",
    "POINTER_NOT_FOUND": "the path is absent from the document",
    "TYPE_EXPECTED_UNKNOWN": "'expected' for operator 'type' is not string/number/boolean/null",
    "TYPE_MISMATCH": "the value is present but not of the declared type",
    "VALUE_MISMATCH": "the value is present but not equal within one JSON type",
    "NUMBER_OPERAND_REQUIRED": "a comparison operand is not a finite non-boolean number",
    "NUMBER_COMPARISON_FAILED": "both operands are finite numbers and the comparison is false",
    "OPERATOR_UNSUPPORTED": "the operator is not one of the seven the evaluator implements",
    "RESPONSE_BODY_OVER_BUDGET": "the bytes exceed the caller's parse budget",
    "RESPONSE_BODY_NOT_UTF8": "the bytes are not decodable as UTF-8",
    "RESPONSE_BODY_NOT_JSON": "the bytes are not one JSON document",
    "JSON_DUPLICATE_KEY": "an object member name repeats",
    "JSON_NESTING_OVER_LIMIT": "the document is nested deeper than the limit",
    "JSON_NUMBER_NOT_FINITE": "a parsed number is not finite",
    "JSON_NUMBER_NOT_LOSSLESS": "an integral number cannot be represented identically in both languages"
  },
  "reading_rules": {
    "assertion_cases": "The body is parsed with the plain JSON parser (JSON.parse / json.loads) on purpose: it must be possible to observe the assertion layer refusing a non-finite value even when a caller handed it a document directly. parseJsonResponse is the layer that would have stopped that body from ever being parsed.",
    "parse_cases": "The body goes through the strict parse entry. body_hex supplies raw bytes that no JSON string can express (invalid UTF-8).",
    "bodies_as_strings": "Every body is a JSON text so that pointer escapes, '1e400' and leading zeros survive the fixture file itself."
  },
  "sentinels": {
    "__string__:<value>": "the literal string <value>, used where a sentinel would otherwise be confused with a body"
  },
  "assertion_cases": [
    { "name": "inherited_constructor_absent", "body": "{}", "pointer": "/constructor", "operator": "exists", "expected_passed": false, "expected_reason": "POINTER_NOT_FOUND" },
