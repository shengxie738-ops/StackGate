        "payload": {
          "type": "object",
          "properties": {
            "payload_version": {
              "const": "0.1"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "required": [
            "payload_version",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
