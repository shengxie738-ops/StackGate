{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackgate.local/schemas/0.1/environment-finalization.schema.json",
  "title": "EnvironmentFinalization",
  "type": "object",
  "properties": {
    "schema_version": { "const": "0.1" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "phase": { "const": "finalize" },
    "observed_at": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
    "provenance": { "$ref": "common.schema.json#/$defs/ProvenanceLevel" },
    "instance_id": { "anyOf": [ { "$ref": "common.schema.json#/$defs/SafeId" }, { "type": "null" } ] },
    "input_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
    "data_revision": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "frontend_origin": { "anyOf": [ { "$ref": "common.schema.json#/$defs/Origin" }, { "type": "null" } ] },
    "backend_origin": { "anyOf": [ { "$ref": "common.schema.json#/$defs/Origin" }, { "type": "null" } ] },
    "requests_observed": { "type": "integer", "minimum": 0 },
    "instance_changed": { "type": "boolean" },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
      "uniqueItems": true,
      "minItems": 1
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
      "uniqueItems": true,
      "minItems": 0
    }
  },
  "required": ["schema_version", "run_id", "phase", "observed_at", "provenance", "instance_id", "input_hash", "data_revision", "frontend_origin", "backend_origin", "requests_observed", "instance_changed", "evidence_refs", "reasons"],
  "additionalProperties": false
}
