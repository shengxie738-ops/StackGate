{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackgate.local/schemas/0.1/environment.schema.json",
  "title": "EnvironmentManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]+$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "attach",
        "compose"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "BLOCKED",
        "ERROR",
        "CLEANED",
        "UNKNOWN"
      ]
    },
    "frontend_origin": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Origin"
        },
        {
          "type": "null"
        }
      ]
    },
    "backend_origin": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Origin"
        },
        {
          "type": "null"
        }
      ]
    },
    "instance_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/SafeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/ProvenanceLevel"
    },
    "input_hash": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "image_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^run_[A-Za-z0-9_-]+$"
          },
          "owner_token": {
            "$ref": "common.schema.json#/$defs/SafeId"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "process",
              "container",
              "network",
              "volume"
            ]
          },
          "native_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "created_at": {
            "$ref": "common.schema.json#/$defs/UtcTimestamp"
          },
          "creation_identity": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "created_by_stackgate": {
            "type": "boolean"
          },
          "cleanup_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CLEANED",
              "PRESERVED",
              "FAILED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "run_id",
          "owner_token",
          "resource_type",
          "native_id",
          "created_at",
          "creation_identity",
          "created_by_stackgate",
          "cleanup_status"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "data_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/SafeId"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "service": {
            "$ref": "common.schema.json#/$defs/SafeId"
          },
          "container_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "host_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "http",
              "https"
            ]
          },
          "publish_host": {
            "const": "127.0.0.1"
          },
          "container_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "origin": {
            "$ref": "common.schema.json#/$defs/Origin"
          }
        },
        "required": [
          "service",
          "container_port",
          "host_port",
          "protocol",
          "publish_host",
          "container_id",
          "origin"
        ],
        "additionalProperties": false
      },
      "minProperties": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "status",
    "frontend_origin",
    "backend_origin",
    "instance_id",
    "provenance",
    "input_hash",
    "image_ids",
    "resources",
    "data_revision",
    "observations",
    "reasons"
  ],
  "additionalProperties": false
}
