{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://stackgate.local/schemas/0.1/execution-owner.schema.json",
 "title":"ExecutionOwner",
 "type":"object",
 "properties":{
  "schema_version":{"const":"0.1"},
  "run_id":{"type":"string","pattern":"^run_[A-Za-z0-9_-]+$"},
  "repo_id":{"$ref":"common.schema.json#/$defs/SafeId"},
  "worktree_id":{"$ref":"common.schema.json#/$defs/SafeId"},
  "owner_token":{"type":"string","format":"uuid"},
  "created_at":{"$ref":"common.schema.json#/$defs/UtcTimestamp"}
 },
 "required":["schema_version","run_id","repo_id","worktree_id","owner_token","created_at"],
 "additionalProperties":false
}
