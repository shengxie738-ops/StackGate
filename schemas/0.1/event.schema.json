        },
        "at": {
          "$ref": "common.schema.json#/$defs/UtcTimestamp"
        },
        "type": {
          "const": "artifact.saved"
        },
        "payload": {
          "type": "object",
          "properties": {
            "payload_version": {
              "const": "0.1"
            },
            "artifact": {
              "$ref": "artifact.schema.json"
            }
          },
          "required": [
